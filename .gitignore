# Python virtualenvs (1.4GB, rebuilt from requirements)
.venv/
.venv-ml/
__pycache__/
*.pyc
*.pyo

# Third-party robot models (2.2GB, fetched by scripts/fetch_assets.sh)
arm-bridge/menagerie/

# Recorded datasets and training artifacts (1.4GB, regenerated by collect scripts)
arm-bridge/dataset/
arm-bridge/serve_dataset/
arm-bridge/*_clips/
arm-bridge/eval_clips/
arm-bridge/policy_clips/

# Simulator logs
MUJOCO_LOG.TXT
*.log

# Node
node_modules/

# OS
.DS_Store

# Secrets, never commit
.env
.env.local
